# Copy to .env on the server (never commit .env).
PROD_DOMAIN=politisation-populaire-francaise.org
# Address used by Let's Encrypt for certificate notices (a project address, not a personal one).
ACME_EMAIL=
# WireGuard address of the server, the only one on which the preproduction listens.
WIREGUARD_SERVER_IP=10.8.0.1
# Preproduction password: generate the hash with "docker run --rm caddy:2 caddy hash-password".
PREPROD_BASIC_AUTH_USER=
PREPROD_BASIC_AUTH_HASH=
