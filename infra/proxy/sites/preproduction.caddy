# Preproduction: https://preprod.<domain>, for the devices of the team only.
#
# - The name is public (DNS record towards the server, so that Let's Encrypt can issue a real
#   certificate, trusted by the Android app and the browsers without installing anything).
# - Only connections coming through the WireGuard tunnel (10.8.0.0/24) are answered; any other
#   connection is closed without a word. The WireGuard profiles route the server's address
#   through the tunnel (infra/scripts/wg-add-peer.sh).
# - Web pages also ask for a password. The API of the applications (/api/, /health) relies on
#   the tunnel alone: the test builds of the apps are public files and can carry no password
#   (decision D-072).
# - Never indexed by search engines.

preprod.{$PPF_DOMAIN} {
	import security_headers
	header X-Robots-Tag "noindex, nofollow"

	@outside not remote_ip 10.8.0.0/24
	@pages not path /api/* /health

	# Written in this order on purpose: route keeps it (the tunnel first, then the password).
	route {
		abort @outside
		basic_auth @pages {
			{$PREPROD_BASIC_AUTH_USER} {$PREPROD_BASIC_AUTH_HASH}
		}
		reverse_proxy ppf-preprod-server-1:8080 {
			# The application never sees the client address.
			header_up -X-Forwarded-For
			header_up -X-Real-IP
		}
	}
}

# Back-office of the team (D-120 and following): its own name, the tunnel only, and the second port
# of the server (8081), which never serves the public site; the public port never serves it either.
# No password here: the back-office has its own passkey login.
equipe.preprod.{$PPF_DOMAIN} {
	import security_headers
	header X-Robots-Tag "noindex, nofollow"

	@outside not remote_ip 10.8.0.0/24

	# The largest form of the back-office: a section of a pole (a long text of the editorial circuit,
	# docs/integration/back-office.md, section 14) reads 256 KiB at most; the server checks the exact limit
	# of each page (64 KiB for the others).
	request_body {
		max_size 256KB
	}

	route {
		abort @outside
		reverse_proxy ppf-preprod-server-1:8081 {
			header_up -X-Forwarded-For
			header_up -X-Real-IP
		}
	}
}

# Approval pages of the signing service (D-129, revision of 8 November 2026): served by the signing
# service itself, on its approval port, never by the main server; the tunnel only. A member approves a
# content there with the usual back-office passkey (same relying party, an origin of its own); the
# owner's app also brings the certificates and the team list signed by the root here directly.
signature.equipe.preprod.{$PPF_DOMAIN} {
	import security_headers
	header X-Robots-Tag "noindex, nofollow"

	@outside not remote_ip 10.8.0.0/24

	# An approval is a few kilobytes; a team list or a batch of certificates, a few hundred at most.
	request_body {
		max_size 1MB
	}

	route {
		abort @outside
		reverse_proxy ppf-preprod-signer-1:8091 {
			header_up -X-Forwarded-For
			header_up -X-Real-IP
		}
	}
}

# Push wake-ups of the preproduction (ntfy, D-078): the tunnel only, like the rest of the preproduction;
# the testers' phones keep the tunnel on. Streams are passed through at once.
push.preprod.{$PPF_DOMAIN} {
	import security_headers
	header X-Robots-Tag "noindex, nofollow"

	@outside not remote_ip 10.8.0.0/24

	route {
		abort @outside
		reverse_proxy ppf-preprod-ntfy-1:8080 {
			header_up -X-Forwarded-For
			header_up -X-Real-IP
			flush_interval -1
		}
	}
}
