# Production, public. Deployed only at the public launch (infra/scripts/deploy.sh production),
# after the DNS records of the main domain and of the five protective extensions point to the
# server.

{$PPF_DOMAIN} {
	import security_headers
	encode zstd gzip
	reverse_proxy ppf-prod-server-1:8080 {
		# The application never sees the client address.
		header_up -X-Forwarded-For
		header_up -X-Real-IP
	}
}

# The other names redirect to the main domain (they protect the name, D-001).
www.{$PPF_DOMAIN}, politisation-populaire-francaise.fr, www.politisation-populaire-francaise.fr, politisation-populaire-francaise.com, www.politisation-populaire-francaise.com, politisation-populaire-francaise.eu, www.politisation-populaire-francaise.eu, politisation-populaire-francaise.net, www.politisation-populaire-francaise.net, politisation-populaire-francaise.app, www.politisation-populaire-francaise.app {
	import security_headers
	redir https://{$PPF_DOMAIN}{uri} permanent
}

# Back-office of the team: tunnel only for version 1 (contract docs/integration/back-office.md,
# section 3, question to the owner), on the second port of the server (8081).
equipe.{$PPF_DOMAIN} {
	import security_headers
	header X-Robots-Tag "noindex, nofollow"

	@outside not remote_ip 10.8.0.0/24

	# The largest form of the back-office: a section of a pole (a long text of the editorial circuit,
	# docs/integration/back-office.md, section 14) reads 256 KiB at most; the server checks the exact limit
	# of each page (64 KiB for the others).
	request_body {
		max_size 256KB
	}

	route {
		abort @outside
		reverse_proxy ppf-prod-server-1:8081 {
			header_up -X-Forwarded-For
			header_up -X-Real-IP
		}
	}
}

# Approval pages of the signing service (D-129, revision of 8 November 2026): served by the signing
# service itself, on its approval port, never by the main server; the tunnel only. A member approves a
# content there with the usual back-office passkey (same relying party, an origin of its own); the
# owner's app also brings the certificates and the team list signed by the root here directly.
signature.equipe.{$PPF_DOMAIN} {
	import security_headers
	header X-Robots-Tag "noindex, nofollow"

	@outside not remote_ip 10.8.0.0/24

	# An approval is a few kilobytes; a team list or a batch of certificates, a few hundred at most.
	request_body {
		max_size 1MB
	}

	route {
		abort @outside
		reverse_proxy ppf-prod-signer-1:8091 {
			header_up -X-Forwarded-For
			header_up -X-Real-IP
		}
	}
}

# Push wake-ups (ntfy, D-078), public: phones keep a connection open to receive constant encrypted
# wake-ups; the client address never reaches ntfy. Streams are passed through at once.
push.{$PPF_DOMAIN} {
	import security_headers
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy ppf-prod-ntfy-1:8080 {
		header_up -X-Forwarded-For
		header_up -X-Real-IP
		flush_interval -1
	}
}
