# Caddy, the only process exposed to the Internet: automatic HTTPS (Let's Encrypt), strict
# headers, no access log (no IP address is ever written).
#
# The sites served are the files of /etc/caddy/sites/, copied there by
# infra/scripts/deploy.sh from infra/proxy/sites/: only preproduction.caddy until the public
# launch, then production.caddy as well. A site that is not deployed is not served at all.
#
# Variables (file /srv/ppf/proxy/.env on the server; model in infra/env/proxy.env.example):
# PPF_DOMAIN, PREPROD_BASIC_AUTH_USER, PREPROD_BASIC_AUTH_HASH.

{
	# No e-mail address is given to the certificate authority: none is required.
	# No access log anywhere: client addresses are never written.
	log {
		output discard
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
		-Via
	}
}

import /etc/caddy/sites/*.caddy
