# Model of /srv/ppf/proxy/.env (written by infra/scripts/bootstrap-server.sh, mode 0600).
# The real file is never in the repository.
PPF_DOMAIN=politisation-populaire-francaise.org
# Password of the preproduction web pages (on top of the WireGuard tunnel).
# The hash is made with: docker run --rm caddy:2.11.9-alpine caddy hash-password
PREPROD_BASIC_AUTH_USER=equipe
# Single quotes: the hash holds "$" signs, which Compose must not interpolate.
PREPROD_BASIC_AUTH_HASH='<bcrypt hash, never the password itself>'
