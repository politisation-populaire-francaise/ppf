# Model of /srv/ppf/production/.env (written by infra/scripts/bootstrap-server.sh, mode 0600).
# The real file is never in the repository.
PPF_SECRETS_DIR=/srv/ppf/production/secrets
POSTGRES_DB=ppf
POSTGRES_USER=ppf
# Public keys (hex or npub) of the editorial team, separated by commas. Never the example key.
PPF_EDITOR_KEYS=
# PPF_SERVER_IMAGE is set by infra/scripts/deploy.sh (always an image digest validated on the
# preproduction).
