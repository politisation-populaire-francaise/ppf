# Model of /srv/ppf/production/.env (written by infra/scripts/bootstrap-server.sh, mode 0600).
# The real file is never in the repository.
PPF_SECRETS_DIR=/srv/ppf/production/secrets
POSTGRES_DB=ppf
POSTGRES_USER=ppf
# Public keys (hex or npub) of the editorial team, separated by commas. Never the example key.
PPF_EDITOR_KEYS=
# Team back-office, reached through the tunnel only (version 1).
PPF_BACKOFFICE_ORIGIN=https://equipe.politisation-populaire-francaise.org
# Exact public address of the production, without a final slash.
PPF_PUBLIC_URL=https://politisation-populaire-francaise.org
# Public key (hex or npub) of the offline audit key pair; its secret key is kept offline by the owner.
PPF_AUDIT_PUBLIC_KEY=
# PPF_SERVER_IMAGE is set by infra/scripts/deploy.sh (always an image digest validated on the
# preproduction).
# Public keys (hex or npub) the testimonies are encrypted for (Agir, M5): moderation team and evidence
# kept for the lawyers. Empty outside production: the example keys; required in production.
PPF_MODERATION_KEY=
PPF_EVIDENCE_KEY=
# Public key (hex) of the root of the signing service of this environment (D-079): created on the owner's
# phone; empty until then (nothing is signed). The preproduction has a root of its own.
PPF_SIGNER_ROOT_PUBKEY=
