# Model of /srv/ppf/preproduction/.env (written by infra/scripts/bootstrap-server.sh, mode 0600).
# The real file is never in the repository. Fictional data only ([EXEMPLE]).
PPF_SECRETS_DIR=/srv/ppf/preproduction/secrets
POSTGRES_DB=ppf_preprod
POSTGRES_USER=ppf_preprod
# Keys allowed to publish editorial contents. On the server, bootstrap-server.sh writes here the
# public key of the example content signer (EditorialTrust.EXAMPLE_EDITOR), so that the [EXEMPLE]
# contents can be updated; never in production.
PPF_EDITOR_KEYS=
# Team back-office, reached through the tunnel only.
PPF_BACKOFFICE_ORIGIN=https://equipe.preprod.politisation-populaire-francaise.org
# Exact public address of the preproduction, without a final slash.
PPF_PUBLIC_URL=https://preprod.politisation-populaire-francaise.org
# Public key (hex or npub) of the offline audit key pair; empty until the owner has created it.
PPF_AUDIT_PUBLIC_KEY=
# PPF_SERVER_IMAGE is set by infra/scripts/deploy.sh (always an image digest).
# Public keys (hex or npub) the testimonies are encrypted for (Agir, M5): moderation team and evidence
# kept for the lawyers. Empty outside production: the example keys; required in production.
PPF_MODERATION_KEY=
PPF_EVIDENCE_KEY=
# Public key (hex) of the root of the signing service of this environment (D-079): created on the owner's
# phone; empty until then (nothing is signed). The preproduction has a root of its own.
PPF_SIGNER_ROOT_PUBKEY=
# Approval pages of the signing service (D-129): written by bootstrap-server.sh from the back-office
# address; the relying party of the team's passkeys, and the signing service's own origin below it.
PPF_SIGNER_RP_ID=equipe.preprod.politisation-populaire-francaise.org
PPF_SIGNER_APPROVAL_ORIGIN=https://signature.equipe.preprod.politisation-populaire-francaise.org
