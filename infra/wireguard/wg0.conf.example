# Server side (/etc/wireguard/wg0.conf). Keys are generated on the server, never committed.
[Interface]
Address = 10.8.0.1/24
ListenPort = 51820
PrivateKey = <server-private-key>

# One block per device of the team. Example for the owner's computer:
[Peer]
# owner-laptop
PublicKey = <device-public-key>
AllowedIPs = 10.8.0.2/32

# Example for the owner's phone:
[Peer]
# owner-phone
PublicKey = <device-public-key>
AllowedIPs = 10.8.0.3/32
