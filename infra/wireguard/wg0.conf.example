# Server side (/etc/wireguard/wg0.conf), written by infra/scripts/bootstrap-server.sh.
# Keys are generated on the server, never committed.
[Interface]
Address = 10.8.0.1/24
ListenPort = 51820
PrivateKey = <server-private-key>

# One block per device of the team, appended by infra/scripts/wg-add-peer.sh. Example:
[Peer]
# device: proprietaire-ordinateur
PublicKey = <device-public-key>
PresharedKey = <device-preshared-key>
AllowedIPs = 10.8.0.2/32
