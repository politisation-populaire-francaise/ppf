# Imports the parliamentary open data of the production, every Monday (Parlement européen).
# Installed by infra/scripts/bootstrap-server.sh; enabled only at the public launch.
[Unit]
Description=PPF: import the parliamentary open data (weekly)
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/ppf-open-data-import --only pe
