# Imports the parliamentary open data of one environment (%i), every day (Assemblée nationale, Sénat,
# presentations of the presidential election, application of the laws).
# Installed by infra/scripts/bootstrap-server.sh; enabled per environment once its import key exists.
[Unit]
Description=PPF: import the parliamentary open data (daily, %i)
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/ppf-open-data-import %i --only an,senat,cc,an-barometre
