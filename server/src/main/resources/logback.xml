<configuration>
    <!-- Console only. No request log: client addresses are never recorded. -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ssXXX} %-5level [%logger{24}] %msg%n</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>
    <logger name="io.netty" level="WARN" />
</configuration>
