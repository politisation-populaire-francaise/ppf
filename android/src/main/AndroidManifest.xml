<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The network, towards the platform's own server and nothing else, in HTTPS only
         (network_security_config.xml). A build without server address (BuildConfig.PPF_SERVER_URL
         empty) makes no network call at all. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Whether the network is Wi-Fi and whether the data saver is on, read before any download in the background
         (« Mes élus ont voté », D-102: « seulement en Wi-Fi » by default). Granted at install, sends nothing. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Notifications (D-130), asked only when the user enables them in Mon espace (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The camera, asked only when a validator opens « Valider une personne » to read the QR code a citizen
         shows (D-112, 4.3); never at install, never for anything else. Nothing is recorded or sent from it:
         the code is read on the phone. Not required: a phone without camera installs the application. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".PpfApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.PPF"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Agenda: shares the .ics file of a mobilization with the application the user chooses
             (read-only, temporary permission per share; files of cache/agenda/ only). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.agenda"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/agenda_files" />
        </provider>

        <!-- Empty wake-ups forwarded by the UnifiedPush distributor (ntfy set to our own server, D-130). -->
        <service
            android:name=".PpfPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
