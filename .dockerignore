# The server image (infra/docker/server.Dockerfile) needs only the built jar and the example
# contents. Everything else stays out of the build context: smaller, faster, and no local file
# (keys, .env, build caches) can ever slip into an image.
*
!server/build/libs/ppf-server.jar
!tools/open-data-importer/build/libs/ppf-open-data-importer.jar
!signer/build/libs/ppf-signer.jar
!shared/ui/src/commonMain/composeResources/files/parlement/*.json
!shared/ui/src/commonMain/composeResources/files/contents/*.json
