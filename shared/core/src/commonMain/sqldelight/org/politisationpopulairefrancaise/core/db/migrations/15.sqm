-- Schema version 15 to 16 (2026-11-07, provisional number, after the anonymous voting of Décider in 14.sqm): notifications and verified contacts on
-- the device (see Notifications.sq and Contacts.sq, the reference for fresh installations; this file must stay identical to its
-- CREATE statements).

CREATE TABLE notification_setting (
    name TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

CREATE TABLE notification_entry (
    id TEXT NOT NULL PRIMARY KEY,
    category TEXT NOT NULL,
    title TEXT NOT NULL,
    detail TEXT,
    target TEXT,
    created_at INTEGER NOT NULL,
    is_read INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX notification_entry_created_at ON notification_entry(created_at DESC, id);

CREATE TABLE notification_mark (
    source TEXT NOT NULL PRIMARY KEY,
    seen_until INTEGER NOT NULL
);

CREATE TABLE push_registration (
    scope TEXT NOT NULL PRIMARY KEY,
    subscription_id TEXT NOT NULL,
    endpoint TEXT NOT NULL,
    renewed_at INTEGER NOT NULL
);

CREATE TABLE contact_verification (
    pubkey TEXT NOT NULL PRIMARY KEY,
    verified_at INTEGER NOT NULL
);
