-- Schema version 18 to 19 (2026-11-11, after the reminders of Décider in 17.sqm): the signups of the user to the
-- slots of calls (AP-11), on the device (see CallSlotSignup.sq, the reference for fresh installations; this file must
-- stay identical to its CREATE statements).

CREATE TABLE call_slot_signup (
    id TEXT NOT NULL PRIMARY KEY,
    call_address TEXT NOT NULL,
    slot_id TEXT NOT NULL,
    token TEXT NOT NULL,
    slot_end INTEGER NOT NULL
);

CREATE INDEX call_slot_signup_call ON call_slot_signup(call_address);
