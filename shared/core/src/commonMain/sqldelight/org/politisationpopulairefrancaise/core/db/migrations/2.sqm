-- Schema version 2 to 3: encrypted messaging tables (see Messaging.sq, which is the reference for
-- fresh installations; this file must stay identical to its CREATE statements). Without it, devices
-- already holding a version 1 or 2 database would never get these tables.

CREATE TABLE conversation (
    id TEXT NOT NULL PRIMARY KEY,
    subject TEXT,
    subject_at INTEGER,
    last_message_at INTEGER NOT NULL
);

CREATE INDEX conversation_last_message_at ON conversation(last_message_at DESC, id);

CREATE TABLE message (
    id TEXT NOT NULL PRIMARY KEY,
    conversation_id TEXT NOT NULL,
    author TEXT NOT NULL,
    content TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    received_at INTEGER NOT NULL,
    subject TEXT,
    reply_to TEXT,
    is_read INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX message_conversation_created_at ON message(conversation_id, created_at DESC, id);
CREATE INDEX message_conversation_unread ON message(conversation_id, is_read);

CREATE TABLE outgoing_wrap (
    id TEXT NOT NULL PRIMARY KEY,
    message_id TEXT NOT NULL,
    event TEXT NOT NULL,
    queued_at INTEGER NOT NULL
);

CREATE INDEX outgoing_wrap_queued_at ON outgoing_wrap(queued_at, id);

CREATE TABLE messaging_state (
    name TEXT NOT NULL PRIMARY KEY,
    value INTEGER NOT NULL
);
