-- Demander un document administratif (DE-31): the requests the person sent herself or himself, noted on the device only
-- so that it counts the deadlines (one month for the administration, two months to ask the CADA). Never sent, never
-- published from here; erased by the quick erase (S-44).
-- Added in schema version 18: existing databases get it through migrations/17.sqm.

-- One request: to whom, which document, how (courriel, copie, consultation), and the days, in days since 1970.
CREATE TABLE document_request (
    id TEXT NOT NULL PRIMARY KEY,
    administration TEXT NOT NULL,
    document TEXT NOT NULL,
    mode TEXT NOT NULL,
    received_on INTEGER NOT NULL,
    answered_on INTEGER,
    refused_on INTEGER,
    cada_on INTEGER
);

insertRequest:
INSERT INTO document_request(id, administration, document, mode, received_on) VALUES (?, ?, ?, ?, ?);

setAnswered:
UPDATE document_request SET answered_on = ? WHERE id = ?;

setRefused:
UPDATE document_request SET refused_on = ? WHERE id = ?;

setCada:
UPDATE document_request SET cada_on = ? WHERE id = ?;

deleteRequest:
DELETE FROM document_request WHERE id = ?;

selectRequest:
SELECT * FROM document_request WHERE id = ?;

selectRequests:
SELECT * FROM document_request ORDER BY received_on DESC, id;

deleteAllRequests:
DELETE FROM document_request;

countRequests:
SELECT COUNT(*) FROM document_request;
