-- The testimonies sent from this device (AG-07, "Mes témoignages"): only what the witness needs to
-- follow them. The text, the photo and the place are NOT kept here once the testimony is sent: they
-- live encrypted in the envelope for the moderation team. Until the server has it (no network),
-- the envelope and the encrypted files wait here (`submission`, `testimony_file`), already
-- encrypted, and are deleted as soon as the server accepts them (S-27, actions en attente).
-- Having testified is itself sensitive: erasing the keys erases this list too.
-- Added in schema version 15: existing databases get them through migrations/14.sqm.

CREATE TABLE testimony (
    id TEXT NOT NULL PRIMARY KEY,
    created_at INTEGER NOT NULL,
    call_address TEXT,
    has_photo INTEGER NOT NULL,
    gave_original INTEGER NOT NULL,
    status TEXT NOT NULL,
    reason TEXT,
    published TEXT,
    submission TEXT,
    updated_at INTEGER NOT NULL
);

CREATE TABLE testimony_file (
    testimony_id TEXT NOT NULL,
    file_id TEXT NOT NULL,
    bytes BLOB NOT NULL,
    PRIMARY KEY (testimony_id, file_id)
);

insertTestimony:
INSERT OR REPLACE INTO testimony(id, created_at, call_address, has_photo, gave_original, status, reason, published, submission, updated_at)
VALUES (?, ?, ?, ?, ?, ?, NULL, NULL, ?, ?);

insertFile:
INSERT OR REPLACE INTO testimony_file(testimony_id, file_id, bytes) VALUES (?, ?, ?);

selectAll:
SELECT id, created_at, call_address, has_photo, gave_original, status, reason, published, CASE WHEN submission IS NULL THEN 0 ELSE 1 END AS unsent
FROM testimony ORDER BY created_at DESC, id ASC;

selectSubmission:
SELECT submission FROM testimony WHERE id = ?;

selectFiles:
SELECT file_id, bytes FROM testimony_file WHERE testimony_id = ?;

selectUnsentIds:
SELECT id FROM testimony WHERE submission IS NOT NULL ORDER BY created_at ASC;

markSent:
UPDATE testimony SET submission = NULL, status = ?, updated_at = ? WHERE id = ?;

deleteFiles:
DELETE FROM testimony_file WHERE testimony_id = ?;

updateStatus:
UPDATE testimony SET status = ?, reason = ?, published = ?, updated_at = ? WHERE id = ?;

deleteTestimony:
DELETE FROM testimony WHERE id = ?;

deleteAllTestimonies:
DELETE FROM testimony;

deleteAllFiles:
DELETE FROM testimony_file;

countTestimonies:
SELECT COUNT(*) FROM testimony;
