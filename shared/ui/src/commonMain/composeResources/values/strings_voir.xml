    <!-- Glossary -->
    <string name="voir_glossary_title">Lire les étiquettes de « Voir »</string>
    <string name="voir_glossary_status">Établi, allégué, en cours d’enquête</string>
    <string name="voir_glossary_established">Établi : prouvé par une source primaire (décision de justice, Journal officiel, compte rendu parlementaire, rapport officiel) ou par plusieurs sources concordantes.</string>
    <string name="voir_glossary_alleged">Allégué : affirmé par une source identifiée, sans être encore prouvé.</string>
    <string name="voir_glossary_investigation">En cours d’enquête : une enquête est ouverte, rien n’est établi à ce stade.</string>
    <string name="voir_glossary_reliability">Niveaux de fiabilité d’un chiffre</string>
    <string name="voir_glossary_high">Fiabilité élevée : source primaire, ou comptage dont la méthode est publique et vérifiable.</string>
    <string name="voir_glossary_medium">Fiabilité moyenne : source connue dont la méthode n’est que partiellement publiée.</string>
    <string name="voir_glossary_low">Fiabilité faible : déclarations non vérifiables ; le chiffre est montré pour ce qu’il est, jamais mélangé aux autres.</string>
    <string name="voir_glossary_procedure">Les étapes d’une procédure judiciaire</string>
    <string name="voir_glossary_enquete">Enquête : la police ou la gendarmerie recherche des preuves sous l’autorité du procureur ou d’un juge d’instruction ; personne n’est encore jugé.</string>
    <string name="voir_glossary_mise_en_examen">Mise en examen : un juge d’instruction estime qu’il existe des indices graves ou concordants (code de procédure pénale, article 80-1). Ce n’est pas une condamnation.</string>
    <string name="voir_glossary_proces">Procès : la personne est jugée par un tribunal.</string>
    <string name="voir_glossary_premiere_instance">Condamnation en première instance : un tribunal a condamné la personne, qui peut faire appel ; la décision n’est pas définitive.</string>
    <string name="voir_glossary_appel">Appel : l’affaire est jugée une seconde fois, par une cour d’appel.</string>
    <string name="voir_glossary_definitive">Condamnation définitive : plus aucun recours n’est possible.</string>
    <string name="voir_glossary_relaxe">Relaxe ou acquittement : la justice a jugé que la personne n’était pas coupable.</string>
    <string name="voir_glossary_non_lieu">Non-lieu : le juge d’instruction met fin à l’affaire sans procès, faute de charges suffisantes.</string>
    <string name="voir_glossary_classement">Classement sans suite : le procureur décide de ne pas poursuivre.</string>
    <string name="voir_glossary_presumption">Toute personne est présumée innocente tant que sa culpabilité n’a pas été établie par une condamnation définitive (Déclaration des droits de l’homme et du citoyen, article 9 ; code civil, article 9-1).</string>
    <string name="voir_glossary_sources">Les sources côte à côte</string>
    <string name="voir_glossary_sources_text">Autorités, organisateurs, comptages indépendants, médias : quand ils ne donnent pas le même chiffre, PPF les affiche tous, chacun avec sa méthode. L’écart entre les sources est lui-même une information.</string>
